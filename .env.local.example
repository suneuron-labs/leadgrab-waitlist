# Microsoft Graph — admin alert to your M365 inbox (server-side only)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Alias used for admin alert delivery
WAITLIST_SENDER_EMAIL=waitlist@leadgrab.suneuron.com

# Primary licensed M365 mailbox (required when WAITLIST_SENDER_EMAIL is an alias)
GRAPH_MAILBOX_USER=you@suneuron.com

# Resend — user confirmation email (external delivery until M365 trial outbound is unblocked)
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@leadgrab.suneuron.com
